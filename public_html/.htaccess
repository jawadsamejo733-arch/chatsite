# ChatSite – Apache settings for GoDaddy cPanel (Linux) hosting.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect everything to HTTPS once your SSL certificate is active (cPanel → SSL/TLS Status).
  # Remove the "#" from the next two lines:
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Internal folders are never public.
  RewriteRule ^(app|storage)(/|$) - [F,L]

  # Mini-sites: https://your-domain/s/<site-address>/
  RewriteRule ^s(/.*)?$ site.php [QSA,L]
</IfModule>

# Hide dotfiles (.user.ini, .git …) and non-web files.
<FilesMatch "(^\.|\.(sql|log|sqlite|md|sh|ini|bak|dist)$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType text/javascript .js
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  <FilesMatch "\.(css|js|svg|png)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
